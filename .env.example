# Supabase (público en navegador y servidor)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui

# Supabase Service Role (SOLO servidor / script de seed — NUNCA usar prefijo NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# Mostrar tarjetas de acceso rápido demo en /login ("true" | "false")
NEXT_PUBLIC_DEMO_MODE=true

# Asistente virtual Patitas IA (SOLO servidor)
GEMINI_API_KEY=tu_gemini_api_key_aqui
